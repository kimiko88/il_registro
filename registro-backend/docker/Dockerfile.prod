# =============================================================================
# IMPORTANT – Build context
# On Render (and locally) this Dockerfile must be built from the
# `registro-backend/` directory, NOT from the repository root:
#
#   docker build -f docker/Dockerfile.prod .
#
# Render setting: "Root Directory" = registro-backend
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build
# Pin to the exact Go version declared in go.mod (go 1.24.x).
# GOTOOLCHAIN=local prevents Go from downloading a newer toolchain
# when the go directive in go.mod is updated by `go get`.
# ---------------------------------------------------------------------------
FROM golang:1.24.11-alpine3.21 AS builder

# Prevent auto-toolchain upgrades: if go.mod requires a higher Go version,
# the build will fail fast with a clear error instead of silently downloading.
ENV GOTOOLCHAIN=local

WORKDIR /app

RUN apk add --no-cache git

# Download dependencies first (layer cached until go.mod/go.sum change)
COPY go.mod go.sum ./
RUN GOTOOLCHAIN=local go mod download

# Verify checksums match go.sum — catches go.mod/go.sum drift early
RUN go mod verify

COPY . .

# Static binary — no libc dependency in the final image
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o api-server ./cmd/api-server/

# ---------------------------------------------------------------------------
# Stage 2: Runtime
# Use a minimal Alpine image; ca-certificates is required for TLS to
# external services (Supabase, SPID IdP metadata, etc.).
# ---------------------------------------------------------------------------
FROM alpine:3.21

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app/api-server .

# NOTE: Do NOT copy .env or .env.example here.
# All configuration is supplied at runtime via environment variables
# (Render → Environment tab, Docker → -e / --env-file, k8s → ConfigMap/Secret).
# Viper reads env vars automatically via AutomaticEnv(); a .env file in the
# container would override those injected values with the placeholder defaults.

EXPOSE 8080

# Native Docker health-check — used by Render, Compose, and k8s liveness probes
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["./api-server"]
