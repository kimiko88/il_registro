# ============================================================
# il_registro — Configurazione ambiente
# Copia questo file in .env e modifica i valori.
# NON committare mai il file .env nel repository.
# ============================================================

# --- Server ---
# Porta HTTP su cui il server ascolta
SERVER_PORT=8080
# Modalità Gin: "debug" (sviluppo) o "release" (produzione)
# In release vengono disabilitate le route di debug e i log verbosi.
SERVER_MODE=release

# Origini browser autorizzate, separate da virgole (frontend web e domini effettivi)
ALLOWED_ORIGINS=https://registro.example.it

# --- PostgreSQL ---
# In produzione usa DB_SSLMODE=require e un utente dedicato (non superuser)
DB_HOST=localhost
DB_PORT=5432
DB_USER=registro_user
DB_PASSWORD=INSERISCI_UNA_PASSWORD_CASUALE_DI_ALMENO_24_CARATTERI
DB_NAME=registro
# Valori: disable | allow | prefer | require | verify-ca | verify-full
# Default sicuro: require
DB_SSLMODE=require

# --- Redis ---
# Usato per revoca JWT, ticket WebSocket e rate limiting.
# Obbligatoria in produzione anche su rete privata: almeno 32 caratteri casuali.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=INSERISCI_64_CARATTERI_ESADICIMALI_GENERATI

# --- Segreti crittografici obbligatori in produzione ---
# Genera valori indipendenti e casuali:
#   openssl rand -hex 32   (ENCRYPTION_KEY)
#   openssl rand -hex 32   (PEPPER_SECRET)
#   openssl rand -hex 32   (REDIS_PASSWORD)
#   openssl rand -hex 64   (JWT_SECRET)
# Non riutilizzare valori tra ambienti e non committare il .env.
ENCRYPTION_KEY=INSERISCI_64_CARATTERI_ESADICIMALI_GENERATI
PEPPER_SECRET=INSERISCI_UN_SEGRETO_CASUALE_DI_ALMENO_32_CARATTERI
# Impostare true solo durante la migrazione dei dati cifrati con la vecchia chiave pubblica.
# Disattivare dopo aver ricifrato tutti i record legacy.
ALLOW_LEGACY_ENCRYPTION_KEY=false
# Abilita temporaneamente la verifica e migrazione di hash bcrypt legacy (pepper pubblico o password raw).
# Disattivare dopo aver migrato/reset tutti gli account.
ALLOW_LEGACY_PASSWORD_PEPPER=true

# --- JWT ---
# Chiave segreta per firmare i token JWT.
# OBBLIGATORIO cambiare in produzione. Usa almeno 64 caratteri casuali:
#   openssl rand -hex 64
JWT_SECRET=INSERISCI_128_CARATTERI_ESADICIMALI_GENERATI

# --- Supabase (opzionale) ---
# Necessario solo se si usa Supabase come storage o auth provider aggiuntivo.
# ⚠️ ATTENZIONE SICUREZZA:
# Use SUPABASE_ANON_KEY for public/client connections.
# NEVER use SUPABASE_SERVICE_ROLE_KEY in client applications as it bypasses all RLS policies!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# --- SPID (Sistema Pubblico di Identità Digitale) ---
# Necessario per l'autenticazione tramite SPID (identità digitale italiana)
# Richiede certificati X.509 e registrazione presso AgID
SPID_ENTITY_ID=https://registro-elettronico.it
SPID_CERT_PATH=./certs/spid.crt
SPID_KEY_PATH=./certs/spid.key
SPID_IDP_METADATA_URL=https://registry.spid.gov.it/metadata

# --- CIE (Carta d'Identità Elettronica) ---
# Necessario per l'autenticazione tramite CIE
CIE_ENTITY_ID=https://registro-elettronico.it
CIE_CERT_PATH=./certs/cie.crt
CIE_KEY_PATH=./certs/cie.key
CIE_IDP_METADATA_URL=https://idserver.servizicie.interno.gov.it/idp/shibboleth


GIN_MODE="release"
