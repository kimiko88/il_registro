{
  "baseUrl": "http://localhost:8080/api/v1",
  "thresholds": {
    "http_req_duration": ["p(95)<300", "p(99)<800"],
    "http_req_failed": ["rate<0.01"]
  },
  "scenarios": {
    "morningRush": {
      "targetVUs": 300,
      "rampUpDuration": "30s",
      "steadyStateDuration": "1m",
      "rampDownDuration": "20s"
    },
    "afternoonRush": {
      "targetVUs": 1500,
      "rampUpDuration": "45s",
      "steadyStateDuration": "2m",
      "rampDownDuration": "30s"
    }
  }
}
