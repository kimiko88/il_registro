# ─────────────────────────────────────────────────────────────────────────────
# registro-frontend — Environment Variables
#
# Copia questo file in `.env.local` per lo sviluppo locale:
#   cp .env.example .env.local
#
# Le variabili con prefisso VITE_ sono esposte al bundle client-side.
# NON inserire secret in variabili VITE_ — sono visibili nel bundle JS.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Backend ──────────────────────────────────────────────────────────────

# URL base del backend. Lasciare vuoto in sviluppo per usare il proxy Vite
# configurato in vite.config.js (proxy → http://localhost:8080).
# In produzione impostare l'URL completo del backend (es. Render, Railway, ecc.)
#
# Esempi:
#   VITE_API_URL=                              # sviluppo locale (proxy Vite)
#   VITE_API_URL=https://api.tuoscuola.it      # produzione
#   VITE_API_URL=https://registro-backend.onrender.com
VITE_API_URL=

# ── PWA & Service Worker ─────────────────────────────────────────────────────

# Abilita il Service Worker PWA in sviluppo (default: false per velocità HMR).
# Impostare a true solo se si deve testare il comportamento offline o le notifiche.
# In produzione il SW è sempre abilitato tramite vite-plugin-pwa.
#
# VITE_PWA_DEV_ENABLED=false

# ── Web Push Notifications (VAPID) ──────────────────────────────────────────
# (Funzionalità futura — non ancora attiva)
#
# Chiave pubblica VAPID per le notifiche push Web (Web Push API).
# Generare con: npx web-push generate-vapid-keys
# La chiave PRIVATA deve stare SOLO nel backend (registro-backend/.env).
#
# VITE_VAPID_PUBLIC_KEY=BExampleVapidPublicKeyHere...

# ── Feature Flags ────────────────────────────────────────────────────────────

# Abilita il pannello di debug accessibilità (AccessibilitySettingsPanel) in sviluppo.
# Lasciare false/vuoto in produzione.
#
# VITE_DEBUG_A11Y=false

# ── Analytics & Monitoring ───────────────────────────────────────────────────
# (Opzionale — solo se si usa un servizio esterno)
#
# Sentry DSN per il tracciamento degli errori frontend.
# Se vuoto, Sentry non viene inizializzato.
#
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Build ────────────────────────────────────────────────────────────────────

# Modalità build: "development" o "production".
# Gestita automaticamente da Vite tramite --mode flag.
# Non modificare manualmente salvo necessità specifiche.
#
# NODE_ENV=development
